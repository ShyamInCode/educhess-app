# Copy to backend/.env and fill in. NEVER commit the real file.
#
# Unlike the frontend's VITE_* vars (which are public by design), everything
# here is server-only. SUPABASE_JWT_SECRET and SUPABASE_SERVICE_ROLE_KEY are
# genuine secrets — anyone holding them can impersonate any user or bypass RLS.

# Supabase → Project Settings → API → Project URL
#
# REQUIRED. This is also the JWKS source: tokens are verified against
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json. Supabase projects sign with an
# asymmetric key (Settings → JWT Keys shows type "ECC (P-256)" or RSA), so the
# public half is fetched from there — no shared secret involved.
SUPABASE_URL=

# LEGACY ONLY — most projects should leave this blank.
#
# Supabase → Settings → JWT Keys → "Legacy JWT Secret" tab. Only needed if your
# project used the old HS256 shared-secret scheme and tokens signed with it are
# still in flight. After migrating, Supabase keeps the old key listed as
# PREVIOUS KEY so unexpired tokens keep working; set this during that window,
# then clear it and set ALLOW_LEGACY_HS256=false once they have aged out
# (access tokens last an hour by default).
#
# Anyone holding this value can mint a token for any user, so the safest
# end state is not to have one at all.
SUPABASE_JWT_SECRET=

# Set false to reject HS256 tokens outright. Do this once the legacy secret is
# revoked — it removes the only shared secret that could leak.
ALLOW_LEGACY_HS256=trueBtelHUTmtzZHHPpLirBff6CG7D0iA2ohiC1Z4mkmQnSyIJ1e456hIWDFFH4dGxXcSUPWPJ/PjCkvPdf0qxJoCg==

# Supabase → Project Settings → API → service_role key.
# Bypasses RLS. Only needed once trusted server-side writes exist
# (e.g. granting an entitlement after a verified Razorpay webhook).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Indza3ZmaWRoa3VqZHJqdW1uZGx5Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NDQ0MDcxMSwiZXhwIjoyMTAwMDE2NzExfQ.7KPRu9STjnFBZlYH51YbuiX0c3NNmj24e1ONlhYJBRg

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

ENVIRONMENT=development
