# Copy this file to `.env` and fill in the values from your Supabase project
# (Dashboard → Project Settings → API). Restart the dev server after editing.
#
# NOTE: VITE_-prefixed vars are compiled into the public JS bundle by design.
# The anon key is therefore PUBLIC — it is not a secret. Row Level Security is
# the only thing protecting your data. Never put the service_role key here.
#
# NEVER put an OAuth *client secret* or a Razorpay *key secret* in this file
# or in .env. Those belong in the Supabase dashboard (Auth → Providers) and in
# `supabase secrets set`. Anything prefixed VITE_ is readable by every visitor.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Which sign-in methods the modal offers, comma separated.
# Valid values: google, email, phone. Order is ignored.
#
# Defaults to `google` alone, which is the recommended production setting
# today: Google OAuth is included in Supabase's free plan and sends no email
# through Supabase, so it sidesteps the built-in SMTP rate limit entirely.
#   * add `email` once custom SMTP is configured (Supabase's own sender is
#     throttled to a few messages an hour and is not meant for production)
#   * add `phone` once an SMS provider is configured AND, for India, sender
#     registration under TRAI DLT rules is complete
VITE_AUTH_METHODS=google

# Razorpay *publishable* key id (rzp_test_... / rzp_live_...). Safe to ship in
# the bundle — it is the public half of the pair. The key secret and the
# webhook secret live in Supabase secrets, never here. Leave this blank and the
# upgrade buttons hide themselves.
VITE_RAZORPAY_KEY_ID=

# Origin of the FastAPI backend in `backend/`, which deploys as its own service
# (Railway/Fly/Render) separately from this static frontend. Leave blank until
# it is deployed — nothing imports `src/lib/api.js` yet, so the app runs fine
# without it. No trailing slash.
#
# Whatever you put here must also appear in the backend's CORS_ORIGINS —
# in reverse: CORS_ORIGINS is this frontend's deployed origin.
VITE_API_URL=
